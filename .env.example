# Copy this file to ".env" and fill in only the keys you have.
# The clipper works with none of them. Never share or commit the real .env.

# Claude writes hooks, titles, descriptions and narration (console.anthropic.com)
ANTHROPIC_API_KEY=

# More natural narrator voice; also set voice.backend: elevenlabs in config.yaml (elevenlabs.io)
ELEVENLABS_API_KEY=

# Faster transcription; also set transcribe.backend: groq in config.yaml (console.groq.com)
GROQ_API_KEY=
